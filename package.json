{
  "name": "rfid-m1-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:electron": "rm -rf dist-electron && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wait-on": "9.0.4"
  }
}
